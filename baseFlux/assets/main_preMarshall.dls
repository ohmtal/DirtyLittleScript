# ~~~ Baseflux ~~~
# Events: OnRender, OnKey and OnMouse
# Vars  : event::mx, event::my, event::type, event::key, event::mod, event::button
#       : flux::ft
# func  : flux::size, flux::maxfps, flux::Close, flux::Text, flux::DrawRect,
#       : flux::DrawFPS


caption = "DLS Baseflux"

SDL_EVENT_KEY_DOWN = 0x300
SDL_EVENT_MOUSE_BUTTON_DOWN = 1025
SDLK_ESCAPE     = 0x0000001b
SDLK_PAGEDOWN   = 0x4000004e
SDLK_RIGHT      = 0x4000004f
SDLK_LEFT       = 0x40000050
SDLK_DOWN       = 0x40000051
SDLK_UP         = 0x40000052

WIDTH  = 800.0
HEIGTH = 450.0
COUNT  = 500

COLOR::CYAN = {0 255 255}

RW = 50
RH = 40

# ----- THIS IS CALLED ONCE BEFORE THE WINDOW IS OPENED TO SETUP STUFF:
OnSetup = function
    flux::EnableVSync = false,
    flux::Company = "FluxCompany"
    flux::Caption = "The flux is here"
    flux::Version = "0.261109.01"
#     print " -------- SETUP 1 count" debug::arraycount
    flux::clearColor = { 30 50 50 255 }
#     print " -------- SETUP 2 count" debug::arraycount
end


InitRects = function
    print " -------- InitRects 1 count" debug::arraycount
    forRange i COUNT
        w = (5 + math::randomf * RW)
        h = (5 + math::randomf * RH)
        Rects[i]  = { (math::random 0 WIDTH - w) (math::random 0 HEIGTH - h ) w h }
#     print " -------- InitRects 2 count" debug::arraycount
        Colors[i] = { (math::random 0 255) (math::random 0 255) (math::random 0 255) 255 }
#     print " -------- InitRects 3 count" debug::arraycount
        Vec[i]    = { (math::randomf * 2.0 - 1.0) (math::randomf * 2.0 - 1.0) }
#     print " -------- InitRects 4 count" debug::arraycount
        Filled[i] = math::random 0 1
    end
#     print " -------- InitRects 5 count" debug::arraycount
end

OnInit = function
    print "-------- DLS Flux Main --------"

    flux::size WIDTH HEIGTH WIDTH HEIGTH
    InitRects
end

# -----------------------------------------------------------------------------

OnUpdate = function
    forRange i COUNT
        Rects[i][0] = Rects[i][0] + Vec[i][0] # * flux::ft
        if Rects[i][0] + Rects[i][2] >= WIDTH || Rects[i][0] <= 0.0
            Vec[i][0] =  Vec[i][0] * -1.0
        end

        Rects[i][1] = Rects[i][1] + Vec[i][1] # * flux::ft
        if Rects[i][1] + Rects[i][3] >= HEIGTH || Rects[i][1] <= 0
            Vec[i][1] =  Vec[i][1] * -1.0
        end
    end
end

OnRender = function
    flux::BatchRect Rects Colors Filled
    flux::DrawFPS 10 30 2;
    flux::Text 120 30 (str::format "mouse: %d %d" event::mx event::my) 2
    # bad practice better define the arrays somewhere else !
    flux::DrawLine {10 55} {WIDTH - 10 55} COLOR::CYAN
    flux::Text 10 60 caption 4
end

# -----------------------------------------------------------------------------

OnKey = function
    if event::type == SDL_EVENT_KEY_DOWN
       if event::key == SDLK_ESCAPE ; flux::Close;;
    end
end

OnMouse = function
    if event::type == SDL_EVENT_MOUSE_BUTTON_DOWN
        print "button" event::button "down"
    end
end
