# Dirty Little Script  scripts/fizzbuzz.dls
# -----------------------------------------------------------------------------

print "\nExample with lambda script function:"
print "====================================\n"

# FizzBuzz while - well formed
doWhile = function
    i = 1.0
    while i <= 100
        if i % 15 == 0
            printraw "FizzBuzz "
        elif i % 3 == 0
            printraw "Fizz "
        elif i % 5 == 0
            printraw "Buzz "
        else
            printraw int::cast i, " ";
        end
        i  = i + 1
    end
    printraw "\n\n"
end



doWhile
