# Benchmark-Test Dirty little Script

JLOOPS = 25
ILOOPS = 1000000
HLOOPS = int::cast ILOOPS / 2.0

p = Point::new {0.0 0.0}

# NOTE it's the same speed ++/-- should be much faster?!

forRange j JLOOPS

    forRange i ILOOPS
        p.x = p.x + 1
    end
    print  "SUM (++) IS: " p.x

    forRange i ILOOPS
        p.x = p.x - 1
    end
    print  "SUM (--) IS: " p.x

    p.x = 66
    print  "set Sum to 66 == " (p.x * 1)

    forRange i ILOOPS
        p.x = p.x * (i + 1)
        p.x = p.x / (i + 1)
    end
    print  "SUM (*/ %i+1) IS: " p.x

    ran = 0.0
    forRange i HLOOPS
        ran = math::randomf * i
        p.x = p.x - ran
        p.x = p.x + ran
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " p.x
end

p.x = p.x - 33.0
print "---------------------"
print "---------------------"
print  "Final sum should be 33.0 == " p.x
print "---------------------"
print "---------------------"
