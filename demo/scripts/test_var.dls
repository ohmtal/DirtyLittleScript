# Benchmark-Test Dirty little Script

JLOOPS = 25
ILOOPS = 1000000
HLOOPS = int::cast ILOOPS / 2.0

globalX = 0.0
j = 0;

# NOTE it's the same speed ++/-- should be much faster?!

forRange j JLOOPS

    forRange i ILOOPS
#         globalX = globalX + 1
        globalX++
    end
    print  "SUM (++) IS: " globalX

    forRange i ILOOPS
#         globalX = globalX - 1
        globalX--
    end
    print  "SUM (--) IS: " globalX

    globalX = 66
    print  "set Sum to 66 == " (globalX * 1)

    forRange i ILOOPS
        globalX = globalX * (i + 1)
        globalX = globalX / (i + 1)
    end
    print  "SUM (*/ %i+1) IS: " globalX

    ran = 0.0
    forRange i HLOOPS
        ran = math::randomf * i
        globalX = globalX - ran
        globalX = globalX + ran
    end
    print  "last ran" ran
    print  "SUM (rand +-) IS: " globalX
end

globalX = globalX - 33.0
print "---------------------"
print "---------------------"
print  "Final sum should be 33.0 == " globalX
print "---------------------"
print "---------------------"
